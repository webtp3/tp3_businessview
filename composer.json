{
	"name": "thomasruta/tp3_tests",
	"type": "library",
	"version": "1.0.0",
	"description":"develop Testings for tp3",
	"minimum-stability": "dev",
	"license":"proprietary",
	"authors": [
		{
			"name": "Thomas Ruta",
			"email": "email@thomasruta.de"
		}

	],
	"config": {
		"optimize-autoloader": true,
		"bin-dir": "bin",
		"vendor-dir":"Build/vendor/",
		"sort-packages": false,
		"web-root": "../../web/"

	},
	"repositories":  {
		"0":{
			"type": "path",
			"url": "Packages/*",
			"options": {
				"symlink": false
			}
		},
		"1": {
			"type": "composer",
			"url": "https://composer.typo3.org/"
		}

	},
	"bin": [
		"cag"
	],
	"require": {
		"php": ">=7.1.0 <=7.2.99",
		"ext-json": "*",
		"ext-pcre": "*",
		"ext-session": "*",
		"ext-xml": "*",
		"ext-fileinfo":"*",
		"ext-mysqli": "*",
		"ext-openssl": "*",
		"ext-zip": "*",
		"ext-zlib":"*",
		"symfony/config":"*",
		"helhum/typo3-composer-setup": "*",
		"helhum/typo3-console": "^5",
		"helhum/config-loader": "*",
		"helhum/typo3-config-handling": "*",
		"helhum/typoscript-rendering":"^2.1",
		"typo3/cms-composer-installers": "^1 || ^2",
		"swiftmailer/swiftmailer": "~5.4.5",
		"symfony/console": "^2.7 || ^3.0 || ^4.0",
		"symfony/finder": "^2.7 || ^3.0 || ^4.0",
		"symfony/polyfill-mbstring": "^1.2",
		"symfony/yaml": "^2.7 || ^3.0 || ^4.0",
		"typo3/class-alias-loader": "^1.0",
		"typo3/cms-impexp":"^8.7.0 || ^9.5",
		"typo3/cms": "8.x-dev as 8.7.26",
		"typo3/cms-cli": "^1.0.2",
		"typo3/cms-fluid": "^8.7",
		"typo3/cms-rsaauth":"^8.7 || ^9",
		"typo3/cms-sys-action":"^8.7 || ^9.5",
		"typo3/cms-taskcenter":"^8.7 || ^9.5",
		"typo3/cms-beuser":"^8.7 || ^9.5",
		"typo3/cms-felogin":"^8.7 || ^9.5",
		"typo3/cms-form":"^8.7 || ^9.5",
		"typo3/cms-info-pagetsconfig":"^8.7 || ^9.5",
		"typo3/cms-recycler":"^8.7 || ^9.5",
		"typo3/cms-reports":"^8.7 || ^9.5",
		"typo3/cms-rte-ckeditor":"^8.7 || ^9.5",
		"typo3/cms-setup":"^8.7 || ^9.5",
		"typo3/cms-t3editor":"^8.7 || ^9.5",
		"typo3/cms-tstemplate":"^8.7 || ^9.5",
		"typo3/cms-func":"^8.7 || ^9.5",
		"typo3/cms-version":"^8.7 || ^9.5",
		"typo3/cms-wizard-crpages":"^8.7 || ^9.5",
		"typo3/cms-wizard-sortpages":"^8.7 || ^9.5",
		"typo3/cms-info":"^8.7 || ^9.5",
		"typo3/cms-workspaces":"^8.7 || ^9.5",
		"typo3/cms-viewpage":"^8.7 || ^9.5",
		"typo3/cms-belog":"^8.7 || ^9.5",
		"typo3/cms-feedit":"^8",
		"typo3/cms-filemetadata":"^8",
		"typo3/cms-fluid-styled-content":"^8",
		"typo3/cms-indexed-search":"^8",
		"typo3/cms-linkvalidator":"^8",
		"bk2k/bootstrap-package": "*",
		"typo3/cms-introduction":"*",
		"fab/vidi":"^2",
		"fab/media":"^4.5",
		"gridelementsteam/gridelements":"^8.3",
		"laxap/bootstrap-grids":"2.0.1",
		"georgringer/news":"^7",
		"dmitryd/typo3-realurl":"*",
		"dmitryd/typo3-dd-googlesitemap":"^2.1 || dev-development",
		"sjbr/static-info-tables":"^6.7",
        "sjbr/static-info-tables-de":"^6",
		"web-tp3/tp3businessview": "^1 || dev-develop",
		"web-tp3/tp3_openhours":"dev-develop",
		"web-tp3/tp3jobs": "dev-develop",
		"web-tp3/tp3mods": "^1",
		"web-tp3/tp3social": "dev-develop",
		"web-tp3/tp3-facebook": "dev-develop",
		"web-tp3/tp3ratings": "dev-develop",
		"web-tp3/tp3_news_extend":"^1.1",
      	"friendsoftypo3/tt-address": "4.0.3",
		"fluidtypo3/vhs":"*",
		"yoast-seo-for-typo3/yoast_seo": "3.0.5",
		"in2code/powermail": "*",
		"causal/tscobj":"*",
		"apen/additional_reports":"*",
		"web-tp3/cal":"1.11.3",
		"web-tp3/wec_map": "^4.1.4",
		"causal/extractor":"^1",
		"snowflakeops/varnish":"^3.0"


	},
	"require-dev": {
		"helhum/dotenv-connector": "^2.0",
		"typo3-console/create-reference-command": "@dev",
		"typo3-console/php-server-command": "*",
		"typo3-console/composer-typo3-auto-install": "^0.2",
		"deployer/deployer": "^6.4",
		"consolidation/robo": "^1.4",
		"codeception/codeception":"*",
		"phpmd/phpmd": "*",
		"friendsofphp/php-cs-fixer": "*",
		"typo3/testing-framework": "^2",
		"se/selenium-server-standalone":"*",
		"typo3/cms-styleguide": "^8",
		"phpstan/phpstan": "0.11.1",
		"enm1989/chromedriver": "*",
		"squizlabs/php_codesniffer": "^3.4",
		"fiunchinho/phpunit-randomizer": "*",
		"phpunit/phpunit": "*",
		"nimut/testing-framework": "*",
        "web-tp3/cag_tests":"^1.2",
		"evoweb/ew-llxml2xliff":"^2",
		"phpspec/phpspec":"^1",
        "facebook/webdriver":"^1",
        "friendsoftypo3/extension-builder":"^8.7 || ^9.5"



	},
	"suggest": {
		"ext-fileinfo": "Used for proper file type detection in the file abstraction layer",
		"ext-gd": "GDlib/Freetype is required for building images with text (GIFBUILDER) and can also be used to scale images",
		"ext-mysqli": "",
		"ext-openssl": "",
		"ext-zip": "",
		"ext-zlib": "TYPO3 uses zlib for amongst others output compression and un/packing t3x extension files"
	},
	"conflict": {
		"symfony/finder": "2.7.44 || 2.8.37 || 3.4.7 || 4.0.7"
	},
	"extra": {
		"typo3/cms": {
			"app-dir": "web",
			"web-dir": "web",
			"bin-dir": "bin",
			"cms-package-dir": "Build/vendor/typo3/cms"
		},
		"typo3/class-alias-loader": {
			"always-add-alias-loader": true,
			"autoload-case-sensitivity": false,
			"class-alias-maps": [
				"Migrations/Code/ClassAliasMap.php"
			]
		},
		"branch-alias": {
			"dev-TYPO3_8-7": "8.x-dev",
			"dev-TYPO3_9-5": "9.5.x-dev"
		},
		"helhum/typo3-console": {
			"install-extension-dummy": false
		},
		"helhum/typo3-config-handling": {
			"main-config": "config/settings.yaml",
			"prod-config": "config/prod.settings.yaml",
			"dev-config": "config/dev.settings.yaml",
			"ext-config": "config/includes/extension.yaml"
		},
		"helhum/dotenv-connector": {
			"cache-dir": "var/cache",
			"allow-overrides": true,
			"env-file": ".env"
		},
		"CAG/composer": {
			"web-root": "web/"
		}
	},

	"scripts": {
		"analyze:php": "phpstan analyse --ansi --no-progress --configuration=phpstan.neon --level=5 web/typo3conf/ext/",
		"typo3-cms-scripts": [
			"typo3cms install:fixfolderstructure",
			"typo3cms install:generatepackagestates"
		],
		"post-autoload-dump": [
			"@typo3-cms-scripts"
		],

		"post-update-cmd": [
			"CAG\\Composer\\PackageHandler::postPackageUpdate"


		],
		"post-dependencies-solving": [
			"CAG\\Composer\\PackageHandler::dependsSolve"
		],
		"cag-update": [
			"CAG\\Composer\\PackageHandler::preUpdate",
			"@composer -v -o --apcu-autoloader update"
		],

		"cag-install": [
			"CAG\\Composer\\PackageHandler::prePackageInstall",
			"@composer -v install"

		],
		"cag-deployer": [
			"@php bin/dep deploy"

		],
		"cag-smoke": [
			"@php  bin/phpunit --configuration Tests/Build/SmokeTests.xml   --log-junit SmokeTests.log"

		],
		"cag-accept": [
			"@php  bin/codecept run Acceptance -c ./Tests/Build/AcceptanceTests.yml"

		],
		"pre-update-cmd": [
			"CAG\\Composer\\PackageHandler::preUpdate"
		],

		"test:php:unit": [
			"@php -v",
			"@php vendor/phpunit/phpunit/phpunit -c vendor/typo3/testing-framework/Resources/Core/Build/UnitTests.xml"
		],
		"CAG_test:core-tests": [
			"@php bin/phpunit --configuration web/typo3conf/ext/cag_tests/Resources/Core/Build/UnitTests.xml   --log-junit UnitTests.log",
			"@php bin/phpunit --configuration web/typo3conf/ext/cag_tests/Resources/Core/Build/UnitTestsDeprecated.xml   --log-junit  UnitTestsDeprecated.log",
			"@php bin/phpunit --configuration web/typo3conf/ext/cag_tests/Resources/Core/Build/FunctionalTests.xml  --log-junit  FunctionalTests.log"
		],
		"CAG_test:extension-tests": [
			"@php bin/phpunit --configuration web/typo3conf/ext/cag_tests/Resources/Ext/Build/UnitTests.xml   --log-junit UnitTests.log",
			"@php bin/phpunit --configuration web/typo3conf/ext/cag_tests/Resources/Ext/Build/UnitTestsDeprecated.xml   --log-junit  UnitTestsDeprecated.log",
			"@php bin/phpunit --configuration web/typo3conf/ext/cag_tests/Resources/Ext/Build/FunctionalTests.xml   --log-junit  FunctionalTests.log"
		],
		"set-version": [
			"CAG\\Composer\\PackageHandler::setVersion"
		],
		"extension-verify-composer-json": [
			"CAG\\Composer\\PackageHandler::verifyAutoloadInfoInLibraries"
		]
	},
	"autoload": {
		"psr-4": {
			"CAG\\Composer\\": "Libraries/composer/",
			"Cag\\Robo\\": "Libraries/robo/",
			"CAG\\Deployer\\": "Libraries/deployer/",
			"Typo3Console\\Typo3AutoInstall\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"TYPO3\\CMS\\Backend\\Tests\\": "typo3/sysext/backend/Tests/",
			"TYPO3\\CMS\\Belog\\Tests\\": "typo3/sysext/belog/Tests/",
			"TYPO3\\CMS\\Beuser\\Tests\\": "typo3/sysext/beuser/Tests/",
			"TYPO3\\CMS\\Core\\Tests\\": "typo3/sysext/core/Tests/",
			"TYPO3\\CMS\\CssStyledContent\\Tests\\": "typo3/sysext/css_styled_content/Tests/",
			"TYPO3\\CMS\\Documentation\\Tests\\": "typo3/sysext/documentation/Tests/",
			"TYPO3\\CMS\\Extbase\\Tests\\": "typo3/sysext/extbase/Tests/",
			"TYPO3\\CMS\\Extensionmanager\\Tests\\": "typo3/sysext/extensionmanager/Tests/",
			"TYPO3\\CMS\\Felogin\\Tests\\": "typo3/sysext/felogin/Tests/",
			"TYPO3\\CMS\\Filemetadata\\Tests\\": "typo3/sysext/filemetadata/Tests/",
			"TYPO3\\CMS\\Fluid\\Tests\\": "typo3/sysext/fluid/Tests/",
			"TYPO3\\CMS\\FluidStyledContent\\Tests\\": "typo3/sysext/fluid_styled_content/Tests/",
			"TYPO3\\CMS\\Form\\Tests\\": "typo3/sysext/form/Tests/",
			"TYPO3\\CMS\\Frontend\\Tests\\": "typo3/sysext/frontend/Tests/",
			"TYPO3\\CMS\\Impexp\\Tests\\": "typo3/sysext/impexp/Tests/",
			"TYPO3\\CMS\\IndexedSearch\\Tests\\": "typo3/sysext/indexed_search/Tests/",
			"TYPO3\\CMS\\Install\\Tests\\": "typo3/sysext/install/Tests/",
			"TYPO3\\CMS\\Lang\\Tests\\": "typo3/sysext/lang/Tests/",
			"TYPO3\\CMS\\Lowlevel\\Tests\\": "typo3/sysext/lowlevel/Tests/",
			"TYPO3\\CMS\\Recordlist\\Tests\\": "typo3/sysext/recordlist/Tests/",
			"TYPO3\\CMS\\Reports\\Tests\\": "typo3/sysext/reports/Tests/",
			"TYPO3\\CMS\\Rsaauth\\Tests\\": "typo3/sysext/rsaauth/Tests/",
			"TYPO3\\CMS\\Saltedpasswords\\Tests\\": "typo3/sysext/saltedpasswords/Tests/",
			"TYPO3\\CMS\\Scheduler\\Tests\\": "typo3/sysext/scheduler/Tests/",
			"TYPO3\\CMS\\Sv\\Tests\\": "typo3/sysext/sv/Tests/",
			"TYPO3\\CMS\\SysAction\\Tests\\": "typo3/sysext/sys_action/Tests/",
			"TYPO3\\CMS\\SysNote\\Tests\\": "typo3/sysext/sys_note/Tests/",
			"TYPO3\\CMS\\Workspaces\\Tests\\": "typo3/sysext/workspaces/Tests/",
			"TYPO3\\CMS\\Recycler\\Tests\\": "typo3/sysext/recycler/Tests/",
			"Helhum\\Typo3Console\\Tests\\": "Tests/Console/"

		},
		"classmap": ["Tests/Fixtures/"]
	}
}
