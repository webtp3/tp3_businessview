# ***************************************************************************************
# Translate currency labels in suggestions
# ***************************************************************************************
[language = *de*]
	TCEFORM.sys_language.static_lang_isocode.suggest.default.additionalSearchFields = lg_name_de
	TCEFORM.sys_language.static_lang_isocode.suggest.default.orderBy = lg_name_de
	TCEFORM.static_countries.cn_currency_uid.suggest.default.additionalSearchFields = cu_name_de
	TCEFORM.static_countries.cn_currency_uid.suggest.default.orderBy = cu_name_de
[global]