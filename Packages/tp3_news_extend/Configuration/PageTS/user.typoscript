#*** Adminpanel
admPanel {

	hide = 0

	enable{

		preview = 1
		cache = 1
		publish = 1
		edit = 1
		tsdebug = 1
		info = 1

		}

}

#*** options in BE
options{

	#*** customize pagetree
	pageTree{

		showNavTitle = 1
		showPageIdWithTitle = 1
		showDomainNameWithTitle = 1
		showPathAboveMounts = 0

	}

	clearCache{
		pages = 1
		system = 0
		all = 0
	}

}


setup{

	thumbnailsByDefault = 1
	resizeTextareas = 1
	resizeTextareas_MaxHeight = 1024
}