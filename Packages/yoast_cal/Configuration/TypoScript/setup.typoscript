[globalVar = GP:tx_cal_controller|uid > 0]
    lib.yoastSEO.currentURL.stdWrap.typolink {
        addQueryString.exclude = type,tx_cal_event[uid]
        additionalParams = &tx_cal_controller[uid]={GP:tx_cal_controller|uid}
        additionalParams.insertData = 1
    }

    lib.yoastSEO.slug.stdWrap.typolink < lib.yoastSEO.currentURL.stdWrap.typolink
    lib.yoastSEO.slug.stdWrap.typolink.forceAbsoluteUrl = 0
[global]

[globalVar = GP:tx_cal_phpicalendar|type > 0] || [globalVar = GP:tx_cal_controller|uid > 0]
    lib.yoastSEO {
        canonicalURL >
        og >
        twitter >

        pageTitle >
        pageTitle = RECORDS
        pageTitle {
            tables = tx_cal_event
            dontCheckPid = 1
            source = {GP:tx_cal_phpicalendar|type},{GP:tx_cal_controller|uid}
            source.insertData = 1

            conf.tx_cal_event = TEXT
            conf.tx_cal_event.field = title
            conf.tx_cal_event.ifEmpty.field = start_date
        }

        description >
        description = RECORDS
        description {
            tables = tx_cal_event
            source = {GP:tx_cal_phpicalendar|type},{GP:tx_cal_controller|uid}
            source.insertData = 1

            conf.tx_cal_event = TEXT
            conf.tx_cal_event.field = description
            conf.tx_cal_event.stripHtml = 1
        }
    }
[global]
