{
	"config": {
		"platform": {
			"php": "7.0.8"
		},
		"classmap-authoritative": true,
		"prepend-autoloader": true
	},
	"autoload": {
		"psr-4": {
			"CAG\\CagTests\\": [
				"../Classes/Console/",
				"../Classes/Core/"
			],
			"CAG\\Composer\\": "Libraries/composer",
			"Cag\\Robo\\": "Libraries/robo",
			"CAG\\Deployer\\": "Libraries/deployer"
		}
	},
	"require": {
		"symfony/console": "^3.4.4",
		"symfony/process": "^3.4.4",
		"helhum/config-loader": "^0.9.0",
		"deployer/deployer": "^6",
		"consolidation/robo": "^1",
		"codeception/codeception":"*"
	},
	"scripts": {
		"cag-update": [
			"CAG\\Composer\\PackageHandler::preUpdate"
		],

		"cag-install": [
			"CAG\\Composer\\PackageHandler::prePackageInstall"
		]
	}
}
