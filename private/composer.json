		"php": ">=7.0.0 <=7.2.99",
		"ext-json": "*",
		"ext-pcre": "*",
		"ext-session": "*",
		"ext-xml": "*",
		"ext-fileinfo":"*",
		"ext-mysqli": "*",
		"ext-openssl": "*",
		"ext-zip": "*",
		"ext-zlib":"*",
		"helhum/typo3-composer-setup": "^0.5.1",
