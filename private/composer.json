{
	"name": "thomasruta/tp3_tests",
	"type": "library",
	"description":"developt Testings for tp3",
	"minimum-stability": "dev",
	"license":"proprietary",
	"authors": [
		{
			"name": "Thomas Ruta",
			"email": "email@thomasruta.de"
		}

	],
	"config": {
		"optimize-autoloader": true,
		"bin-dir": "bin",
		"vendor-dir":"Build/vendor/",
		"sort-packages": false

	},
	"repositories":  {
		"0":{
			"type": "path",
			"url": "Packages/*"
		},
		"1": {
			"type": "composer",
			"url": "https://composer.typo3.org/"
		}


	},

